FROM mcr.microsoft.com/devcontainers/python:3.12

USER root

# Update system packages and install required tools
RUN apt-get update \
    && apt-get upgrade -y \
    && apt-get install -y \
        vim \
        tree \
        pre-commit \
        git \
        curl \
        build-essential \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up user environment
ENV USER=vscode
ENV USER_HOME=/home/${USER}
ENV PATH="${USER_HOME}/.local/bin:${USER_HOME}/.cargo/bin:${PATH}"

USER $USER
WORKDIR $USER_HOME

# Create necessary directories
RUN mkdir -p ${USER_HOME}/.local/bin ${USER_HOME}/.cargo/bin

# Install uv (Python package manager)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# Copy and install Python dependencies
COPY --chown=$USER:$USER ./pyproject.toml ./
RUN uv sync --all-extras

# Persist PATH changes for interactive sessions
RUN echo 'export PATH="${USER_HOME}/.local/bin:${USER_HOME}/.cargo/bin:${PATH}"' >> ${USER_HOME}/.bashrc

# Set up git configuration defaults (can be overridden)
RUN git config --global init.defaultBranch main \
    && git config --global pull.rebase false

# Create logs directory for application
RUN mkdir -p ${USER_HOME}/logs

# Health check to ensure uv is working
RUN uv --version
